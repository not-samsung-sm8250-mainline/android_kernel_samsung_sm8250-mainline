# Samsung Galaxy S20 FE (r8q) fragment, merges on top of defconfig.
# No CMDLINE_FORCE here: the stock bootloader androidboot.* must survive.

# Framebuffer console boot path
CONFIG_FB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y

# Qualcomm SM8250 platform core, built-in
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_PINCTRL_SM8250=y
CONFIG_SM_GCC_8250=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_STATS=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QCOM_TSENS=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_RTC_DRV_PM8XXX=y

# UFS storage, built-in
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# Filesystems
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y

# USB
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Debugging and diagnostics
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_HIST_TRIGGERS=y
CONFIG_MAGIC_SYSRQ=y

# Miscellaneous userspace needs
CONFIG_AUTOFS_FS=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y
CONFIG_BINFMT_SCRIPT=y

# Touchscreen: geni I2C, FTS5CU56A and Zinitix
CONFIG_I2C_QCOM_GENI=m
CONFIG_QCOM_GPI_DMA=m
CONFIG_TOUCHSCREEN_FTS5CU56A=m
CONFIG_TOUCHSCREEN_ZINITIX=m

# Battery: MAX77705 MFD, charger and max17042 fuel gauge
CONFIG_BATTERY_MAX17042=m
CONFIG_MFD_MAX77705=m
CONFIG_CHARGER_MAX77705=m

# Camera: CAMSS, CCI and sensors
CONFIG_SM_CAMCC_8250=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_HI847=m
CONFIG_VIDEO_AK7375=m
CONFIG_VIDEO_CCS=m
CONFIG_VIDEO_S5K3M5=m
# dma-buf heaps
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
# CONFIG_DMABUF_HEAPS_CMA is not set
# Android userspace base options
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_PSI=y
CONFIG_RSEQ=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_SYSVIPC=y
CONFIG_KEYS=y
CONFIG_BPF_SYSCALL=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_DM_UEVENT=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_BOOT_CONFIG=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_TUN=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_INPUT_UINPUT=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_RTC_HCTOSYS=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_MHI=m
CONFIG_MHI_BUS=m
CONFIG_MHI_BUS_PCI_GENERIC=m
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_CHAR=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_DRM_MSM=m
CONFIG_PINCTRL_MSM=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_MEMFD_CREATE=y
CONFIG_SYNC_FILE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
